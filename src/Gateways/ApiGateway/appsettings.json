{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FreshFruit.Auth",
    "Audience": "FreshFruit.Clients",
    "SigningKey": "",
    "ExpirationMinutes": 120
  },
  "DemoAuth": {
    "Password": ""
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/basket/{**catch-all}"
        }
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://fruit-catalog-api:8080"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://fruit-basket-api:8080"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://fruit-ordering-api:8080"
          }
        }
      }
    }
  }
}
