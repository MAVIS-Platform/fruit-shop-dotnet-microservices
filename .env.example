# ==============================================================================
# Project Trái Cây — FreshFruit Microservices Environment Configuration
# Copy to .env and customize for local Docker Compose runs (never commit .env).
# ==============================================================================

# PostgreSQL (Database-per-Service)
CATALOG_DB_USER=postgres
CATALOG_DB_PASSWORD=postgres_dev_change_me
CATALOG_DB_NAME=catalog_db

ORDERING_DB_USER=postgres
ORDERING_DB_PASSWORD=postgres_dev_change_me
ORDERING_DB_NAME=ordering_db

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Signing (HMAC-SHA256 — minimum 32 characters for HS256)
JWT_ISSUER=FreshFruit.Auth
JWT_AUDIENCE=FreshFruit.Clients
JWT_SIGNING_KEY=FreshFruit-SuperSecret-Dev-SigningKey-Min32Chars-2026!

# Demo Login Password (for ApiGateway Demo Auth Token Issuer only)
DEMO_AUTH_PASSWORD=FreshFruit@123

# OpenTelemetry Collector OTLP Endpoint (leave empty to disable OTLP export)
OTEL_EXPORTER_OTLP_ENDPOINT=
